# Copia este archivo como .env y llena los valores. .env NUNCA se sube al repositorio.
# En producción estas variables se configuran en Azure Container Apps (backend) y en GitHub Secrets (workflows).

# Base de datos (local: la de compose.yaml; producción: cadena JDBC de Neon con ?sslmode=require)
DB_URL=jdbc:postgresql://localhost:5432/nexfit
DB_USER=nexfit
DB_PASSWORD=
DB_POOL_SIZE=5

# En local (http) debe ser false; en producción (https) true
COOKIE_SECURE=false

# Solo para compose.yaml (base local de desarrollo)
POSTGRES_PASSWORD=

# Solo para el procedimiento de inicialización del Master (perfil bootstrap, NEX-15; ver db/seeds/README.md).
# Déjalas vacías aquí: si falta alguna, el procedimiento la pide por terminal. Nunca guardes la contraseña real en este archivo.
NEXFIT_MASTER_EMAIL=
NEXFIT_MASTER_PASSWORD=
