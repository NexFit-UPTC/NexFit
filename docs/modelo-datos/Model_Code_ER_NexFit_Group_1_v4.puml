health_insurance_providers |o--o{ organization_members : "cubre"
organization_members ||--o{ emergency_contacts : "registra"
membership_plans ||--o{ memberships : "origina"
organization_members ||--o{ memberships : "adquiere"
memberships |o--o{ payments : "origina"
organization_members ||--o{ payments : "realiza"
organization_members ||--o{ check_ins : "ingresa"
branches ||--o{ check_ins : "recibe"
branches ||--o{ classes : "aloja"
trainer_profiles |o--o{ classes : "dicta"
classes ||--o{ class_bookings : "tiene"
organization_members ||--o{ class_bookings : "reserva"
trainer_profiles ||--o{ trainer_clients : "entrena"
organization_members ||--o{ trainer_clients : "es alumno"
trainer_clients ||--o{ routines : "recibe"
routines ||--|{ routine_exercises : "incluye"
exercises ||--o{ routine_exercises : "se usa en"
organization_members ||--o{ workout_logs : "registra entrenamientos"
routines ||--o{ workout_logs : "se realiza en"
workout_logs ||--|{ workout_log_items : "marca"
